{
  "workbench.iconTheme": "eq-material-theme-icons-palenight",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
  },
  "terminal.integrated.shell.windows": "C:\\WINDOWS\\System32\\cmd.exe",
  "liveServer.settings.donotVerifyTags": true,
  "explorer.confirmDelete": false,
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "workbench.colorTheme": "GitHub Dark Colorblind (Beta)",
  "window.titleBarStyle": "custom",
  "git.ignoreMissingGitWarning": true,
  "bracket-pair-colorizer-2.depreciation-notice": false,
  "explorer.confirmDragAndDrop": false,
  "code-runner.runInTerminal": true,
  "git.confirmSync": false,
  "dart.showInspectorNotificationsForWidgetErrors": false,
  "dart.debugExternalPackageLibraries": true,
  "dart.debugSdkLibraries": true,
  "jupyter.askForKernelRestart": false,
  "[python]": {
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "python": true,
    "cpp": true,
  },
  "window.zoomLevel": 1,
  "python.formatting.provider": "none",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.inlineSuggest.showToolbar": "always",
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "debug.onTaskErrors": "showErrors",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "errorLens.fontSize": "0.0em",
  "errorLens.codeLensEnabled": true,
  "errorLens.enabled": true,
  "errorLens.fontStyleItalic": true,
  "errorLens.decorations": {
    "errorRange": {},
    "warningRange": {},
    "infoRange": {},
    "hintRange": {},
  },
  "errorLens.borderRadius": "0.8em",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.sql": "default",
    "*.ico": "luna.editor",
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "amazonQ.workspaceIndex": true,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "[latex]": {
    "editor.defaultFormatter": "mathematic.vscode-latex",
  },
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop",
  ],
  "git.ignoreLegacyWarning": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontSize": 10,
  "update.enableWindowsBackgroundUpdates": false,
  "update.mode": "none",
  "notebook.lineNumbers": "on",
  "files.autoSave": "afterDelay",
  "workbench.startupEditor": "none",
  "diffEditor.ignoreTrimWhitespace": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.fixes": false,
  "editor.inlineSuggest.edits.showCollapsed": true,
  "python.analysis.typeCheckingMode": "off",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "terminal.integrated.inheritEnv": false,
  "python.defaultInterpreterPath": "/bin/python3",
  "extensions.autoUpdate": false,
  "remote.SSH.remotePlatform": {
    "magnolia.usm.edu": "linux",
  },
  "chat.tools.terminal.autoApprove": {
    "*": true,
    "npx": true,
    "../logs/mcp.log": true,
    "curl": true,
    "jq": true,
    "MCP_PORT=4007": true,
    "../logs/ad-campaign-mcp.log": true,
    "mcps:": true,
    "length,": true,
    "length]": true,
    "add)}'": true,
    "\"prompt\":": true,
    "/dev/null": true,
    "workflow:": true,
    "http_code}\"": true,
    "ddcutil": true,
    "lsmod": true,
    "pip3": true,
    "pip": true,
    "pytest": true,
    "xtmonctl": true,
    "git": true,
    "npm install": true,
    "npm run dev": true,
    "/usr/bin/gcc": true,
    "/home/thorodinson/Desktop/CSC306/Lab3a/fig3_30": true,
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "workbench.editor.empty.hint": "hidden",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "xml.server.vmargs": "-Xmx256M",
  "chat.agent.maxRequests": 200,
  "editor.aiStats.enabled": true,
  "chat.emptyState.history.enabled": true,
  "chat.tools.terminal.autoReplyToPrompts": true,
  "python.analysis.userFileIndexingLimit": 5000,
  "diffEditor.maxComputationTime": 0,
  "git.ignoreRebaseWarning": true,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.preferredLocation": "panel",
  "@azure.argTenant": "",
  "chat.mcp.gallery.enabled": true,
  "openscad.executablePath": "openscad",
  "python.createEnvironment.trigger": "off",
  "diffEditor.hideUnchangedRegions.enabled": true,
  "workbench.sideBar.location": "right",
  "remote.SSH.connectTimeout": 30,
}
